# Core domain and timezone
ACS_HOST=acs.shezanet.net
TZ=Asia/Jakarta

# Optional subdomains under wildcard *.shezanet.net
UI_HOST=ui.shezanet.net
NBI_HOST=nbi.shezanet.net
FS_HOST=fs.shezanet.net

# Initial GenieACS UI admin credentials (replace before production)
GENIEACS_UI_USERNAME=admin
GENIEACS_UI_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GENIEACS_UI_JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# MongoDB root credentials (replace before production)
MONGO_ROOT_USERNAME=genieacs_root
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD

# Internal service connection URIs
GENIEACS_MONGODB_CONNECTION_URL=mongodb://genieacs_root:CHANGE_ME_MONGO_PASSWORD@mongo:27017/genieacs?authSource=admin
GENIEACS_REDIS_URL=redis://redis:6379

# External endpoints (for operations/scripts and references)
GENIEACS_CWMP_URL=https://acs.shezanet.net
GENIEACS_NBI_URL=https://nbi.shezanet.net
GENIEACS_UI_URL=https://ui.shezanet.net
GENIEACS_FS_URL=https://fs.shezanet.net

# TLS mode reference (documented in README/docs)
# CERT_MODE=provided|bootstrap

# Multi-site metadata (optional convention only)
DEFAULT_SITE_TAG=site-jakarta
SITE_TAGS=site-jakarta,site-bandung,site-surabaya
