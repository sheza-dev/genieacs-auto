COMPOSE_PROJECT_NAME=genieacs-auto
BASE_DOMAIN=example.com
ACME_EMAIL=admin@example.com
ACME_DNS_PROVIDER=cloudflare
ACME_DNS_PROPAGATION_DELAY=30
TZ=UTC
TRAEFIK_IMAGE=traefik:v3.2
GENIEACS_IMAGE=drumsergio/genieacs:1.2.16.0
MONGO_IMAGE=mongo:8.0
GENIEACS_DB_NAME=genieacs
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root-password
MONGO_APP_USERNAME=genieacs
MONGO_APP_PASSWORD=change-me-app-password
GENIEACS_UI_JWT_SECRET=change-me-ui-jwt-secret
GENIEACS_EXT_DIR=./data/ext
GENIEACS_LOG_DIR=./data/logs
TRAEFIK_DATA_DIR=./data/traefik
MONGO_DATA_DIR=./data/mongo/db
MONGO_CONFIGDB_DIR=./data/mongo/configdb
UI_HOST=ui.example.com
ACS_HOST=acs.example.com
NBI_HOST=api.example.com
FS_HOST=files.example.com
